# MCP Server Configuration
# Rename this file to `.env` and fill in your values.

# The GitHub Personal Access Token is required to authenticate the GitHub MCP Server.
# It acts as the "password" for accessing your remote repositories, reading issues, and creating PRs.
# 
# How to get a token:
# 1. Go to GitHub -> Settings -> Developer Settings -> Personal Access Tokens -> Tokens (classic)
# 2. Generate a new token with at least `repo` and `read:org` scopes.
# 3. Paste it below.

GITHUB_PERSONAL_ACCESS_TOKEN=your_personal_access_token_here
