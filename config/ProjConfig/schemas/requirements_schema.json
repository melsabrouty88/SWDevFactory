{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Requirements Schema",
  "type": "object",
  "properties": {
    "req_id": {
      "type": "string",
      "description": "Generated requirement ID (unique identifier, e.g., REQ-001)"
    },
    "github_issue_id": {
      "type": "integer",
      "description": "The parent ticket ID this requirement originated from"
    },
    "title": {
      "type": "string",
      "description": "High-level summary of the requirement"
    },
    "description": {
      "type": "string",
      "description": "Formal, testable description"
    },
    "acceptance_criteria": {
      "type": "string",
      "description": "Bulleted list of criteria"
    },
    "priority": {
      "type": "string",
      "enum": ["High", "Medium", "Low"],
      "description": "Requirement priority"
    },
    "status": {
      "type": "string",
      "enum": ["Pending", "Designed", "Implemented", "Tested"],
      "description": "Current lifecycle status"
    },
    "creation_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the requirement was created"
    },
    "last_modification_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the most recent update"
    },
    "comment": {
      "type": "string",
      "description": "Additional context, agent notes, or user clarifications"
    }
  },
  "required": [
    "req_id",
    "github_issue_id",
    "title",
    "description",
    "priority",
    "status",
    "creation_date",
    "last_modification_date"
  ]
}
