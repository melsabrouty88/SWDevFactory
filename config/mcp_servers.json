{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        // TODO: Implement a secure storage solution (e.g., .netrc or a secrets manager) for the Personal Access Token.
        "GITHUB_PERSONAL_ACCESS_TOKEN": "REPLACE_WITH_YOUR_TOKEN_FROM_ENV"
      }
    },
    "csv": {
      "command": "npx",
      "args": [
        "-y",
        "@ishayoyo/excel-mcp"
      ]
    }
  }
}
